# Ivano PMS environment variables

# --- Convex (apps/web) ---
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# --- Convex Auth (Convex dashboard env) ---
# SITE_URL=https://pms.techivano.com
#   Local: http://localhost:3000
# JWT_PRIVATE_KEY=  (PKCS8, single line with spaces for newlines — see scripts/generate-auth-keys.mjs)
# JWKS=             (public JWK set JSON)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Ivano PMS <signin@techivano.com>
# CONVEX_SITE_URL is set automatically by Convex (auth.config.ts issuer domain)

# --- Shared secret (Convex dashboard AND apps/web/.env.local) ---
# Generate: openssl rand -hex 32
INTERNAL_JOB_SECRET=

# --- Channel token encryption (Convex dashboard only) ---
# Generate: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=

# --- Webhooks (Next.js POST /api/webhooks) ---
WEBHOOK_SECRET=
DEFAULT_PROPERTY_ID=

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Channel provider tokens (Week 2+ — provider-specific adapters)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp OAuth Connect (Vercel / apps/web — do not invent values)
# Meta Developer App → WhatsApp product → Facebook Login
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Optional; defaults to {NEXT_PUBLIC_APP_URL}/api/oauth/whatsapp/callback
WHATSAPP_OAUTH_REDIRECT_URI=
# Optional fallback phone number id when Graph lookup cannot resolve one
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
# Convex: TELEGRAM_BOT_USERNAME (without @, e.g. IvanoPMSBot)
TELEGRAM_BOT_USERNAME=
# Convex: TELEGRAM_WEBHOOK_URL (e.g. https://pms.techivano.com/api/webhooks/telegram)
# Convex + Vercel: TELEGRAM_WEBHOOK_SECRET (setWebhook secret_token + X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Vercel + Cloudflare Email Worker: shared secret (X-Email-Webhook-Secret header)
EMAIL_WEBHOOK_SECRET=
INSTAGRAM_VERIFY_TOKEN=
